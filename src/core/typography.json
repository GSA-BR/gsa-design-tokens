{
  "$description": "Base typography tokens: fonts, sizes, weights, line heights, and letter spacing.",
  "family": {
    "sans":  "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "mono":  "'JetBrains Mono', 'Cascadia Code', 'Fira Code', 'Courier New', monospace",
    "serif": "Georgia, 'Times New Roman', serif"
  },
  "size": {
    "xs":   "0.75rem",
    "sm":   "0.875rem",
    "base": "1rem",
    "md":   "1.125rem",
    "lg":   "1.25rem",
    "xl":   "1.5rem",
    "2xl":  "1.875rem",
    "3xl":  "2.25rem",
    "4xl":  "3rem",
    "5xl":  "3.75rem"
  },
  "weight": {
    "light":     "300",
    "regular":   "400",
    "medium":    "500",
    "semibold":  "600",
    "bold":      "700",
    "extrabold": "800"
  },
  "line-height": {
    "none":    "1",
    "tight":   "1.25",
    "snug":    "1.375",
    "normal":  "1.5",
    "relaxed": "1.625",
    "loose":   "2"
  },
  "letter-spacing": {
    "tighter": "-0.05em",
    "tight":   "-0.025em",
    "normal":  "0em",
    "wide":    "0.025em",
    "wider":   "0.05em",
    "widest":  "0.1em"
  }
}
