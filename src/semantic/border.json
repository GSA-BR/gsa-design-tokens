{
  "$description": "Semantic border tokens. Defines color and focus for component borders.",
  "$extends": "gsa-light",
  "default":    "{core.gray.200}",
  "strong":     "{core.gray.300}",
  "subtle":     "{core.gray.100}",
  "focus":      "{core.blue.500}",
  "focus-ring": "rgba(59, 130, 246, 0.2)",
  "error":      "{core.red.500}",
  "success":    "{core.green.500}",
  "warning":    "{core.amber.500}",
  "info":       "{core.blue.400}",
  "inverse":    "{core.gray.600}",
  "width": {
    "thin":    "1px",
    "default": "1px",
    "thick":   "2px"
  }
}
