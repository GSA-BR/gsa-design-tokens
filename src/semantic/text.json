  "$extends": "gsa-light",
  "primary":    "{core.gray.800}",
  "secondary":  "{core.gray.500}",
  "tertiary":   "{core.gray.400}",
  "disabled":   "{core.gray.300}",
  "inverse":    "{core.white}",
  "link":       "{core.blue.600}",
  "link-hover": "{core.blue.800}",
  "on-primary": "{core.white}",
